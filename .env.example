NODE_ENV=development
PORT=10000
DATABASE_URL=postgresql://username:password@localhost:5432/onhacks

# Google OAuth web application credentials.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:10000/api/auth/google/callback

# Resend HTTPS API for participant application receipts only.
RESEND_API_KEY=
EMAIL_FROM=ONHacks <hello@onhacks.ca>
