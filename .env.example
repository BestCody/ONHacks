NODE_ENV=development
PORT=10000
DATABASE_URL=postgresql://username:password@localhost:5432/onhacks

# Google OAuth web application credentials.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:10000/api/auth/google/callback
SITE_ORIGIN=http://localhost:5173

# Brevo transactional API key: account verification, application receipts, and acceptance emails.
# EMAIL_FROM must be a sender verified in Brevo.
BREVO_API_KEY=
EMAIL_FROM=ONHacks <hello@onhacks.ca>

# Generate with `npm run organizer:hash-password`; paste only the hash into Render.
ORGANIZER_PASSWORD_HASH=
